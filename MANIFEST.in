include README.md
include README.zh-CN.md
include llm.example.json
include CHANGELOG.md
include CONTRIBUTING.md
include SECURITY.md
include THIRD_PARTY_NOTICES.md
include install.sh
include run_demo.sh

recursive-include docs *.md *.drawio *.png
recursive-include examples *.py

include integrations/asnumpy/README.md
include integrations/asnumpy/0001-move-private-native-results.patch

# AsNumpy is delivered as a release-adjacent, hash-bound internal component.
# Keep legal/provenance attachments and the exact platform wheel beside the
# lock.  Explicit names avoid packaging unrelated build output.
include components/asnumpy/manifest.json
include components/asnumpy/README.md
include components/asnumpy/LICENSE
include components/asnumpy/SBOM.spdx.json
include components/asnumpy/*.whl

# Author-maintained static CANNBot skill snapshot; runtime must not fetch latest.
include components/cannbot-skills/39919e2c995e1cd9e193f11ac2e3fcb3cbd1d26c/manifest.json
include components/cannbot-skills/39919e2c995e1cd9e193f11ac2e3fcb3cbd1d26c/bundle.json
include docs/asnumpy-api-support.zh-CN.md

prune tools
include tools/audit_script_benchmark_receipt.py
include tools/check_release_tree.py
include tools/release_artifact_manifest.py
include tools/render_demo_summary.py
include tools/render_migration_report.py

recursive-include .codeartsdoer/agents *.md
include .codeartsdoer/skills/ProjectSkillStatus.txt
recursive-include .codeartsdoer/skills/numpilot-migration-gate *.md *.yaml
recursive-include skill *.md *.yaml
recursive-include .codeartsdoer/skills/asnumpy-custom-op-integration *.md *.yaml

# Defense in depth: these names remain forbidden even when absent from Git.
exclude todo.md
exclude NumPilot20260615-v1.pdf
exclude TEMP-RECORDING-COMMANDS.zh-CN.md
prune tests

# Never package a filled local credential file, even if one exists in a
# developer checkout.  The blank tracked template is llm.example.json.
global-exclude llm.json
global-exclude __pycache__ *.py[cod] *.db *.log *.npy *.npz *.tmp *.orig
