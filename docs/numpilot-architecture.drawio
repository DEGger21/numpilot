<mxfile host="app.diagrams.net" modified="2026-08-28T08:55:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="ordinary-user-flow" name="01-ordinary用户主流程">
    <mxGraphModel dx="2200" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="p1-0"/>
        <mxCell id="p1-1" parent="p1-0"/>
        <mxCell id="p1-title" value="NumPilot 比赛主链：ordinary script 是唯一默认用户入口" style="text;html=1;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="p1-1"><mxGeometry x="40" y="20" width="1300" height="45" as="geometry"/></mxCell>
        <mxCell id="p1-rule" value="确定性事实由 AST + runtime evidence 判定；模型价值集中在复杂语义、缺口算子与 AsNumPy 工程接入；模型产物必须通过本地门禁" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D79B00;fontStyle=1;fontSize=13;" vertex="1" parent="p1-1"><mxGeometry x="1370" y="10" width="770" height="62" as="geometry"/></mxCell>

        <mxCell id="p1-ready" value="依赖已显式准备&#xa;bootstrap lock/receipt 通过&#xa;import 不联网；migrate 不下载依赖，GLM 是明确模型动作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;fontSize=13;" vertex="1" parent="p1-1"><mxGeometry x="45" y="125" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="p1-source" value="普通纯 NumPy 文件&#xa;import numpy as np&#xa;不要求 build_inputs / forward" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontStyle=1;fontSize=15;" vertex="1" parent="p1-1"><mxGeometry x="355" y="125" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="p1-scan" value="惰性整文件 AST 扫描（确定性前端）&#xa;枚举真实绑定的调用点；不 import、不执行源码&#xa;动态 alias / 未审计 operator、method、nested path 失败关闭" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;fontSize=13;" vertex="1" parent="p1-1"><mxGeometry x="665" y="115" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="p1-cap" value="实际 AsNumpy capability&#xa;API + 签名 + version/hash + CANN/SoC + provenance&#xa;不是只看函数名是否存在" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;fontSize=14;" vertex="1" parent="p1-1"><mxGeometry x="1025" y="115" width="320" height="110" as="geometry"/></mxCell>

        <mxCell id="p1-direct" value="DIRECT&#xa;全部 strict / qualified scoped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;fontSize=16;" vertex="1" parent="p1-1"><mxGeometry x="1430" y="95" width="300" height="72" as="geometry"/></mxCell>
        <mxCell id="p1-consent" value="FALLBACK_CONSENT&#xa;已审计 CPU / conditional CPU / host-assisted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;fontSize=15;" vertex="1" parent="p1-1"><mxGeometry x="1430" y="205" width="300" height="82" as="geometry"/></mxCell>
        <mxCell id="p1-gap" value="GAP_REQUIRED&#xa;API 确实 missing，或用户拒绝 audited fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;fontSize=15;" vertex="1" parent="p1-1"><mxGeometry x="1430" y="330" width="300" height="82" as="geometry"/></mxCell>
        <mxCell id="p1-capaudit" value="CAPABILITY_AUDIT_REQUIRED&#xa;callable + UNKNOWN / runtime 身份漂移 / 存在但未审计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;fontSize=14;" vertex="1" parent="p1-1"><mxGeometry x="1430" y="455" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="p1-blocked" value="BLOCKED&#xa;动态、签名或 Python 执行表面当前无法安全处理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;fontSize=15;" vertex="1" parent="p1-1"><mxGeometry x="1430" y="590" width="300" height="82" as="geometry"/></mxCell>

        <mxCell id="p1-glm" value="当前 ordinary 路径：model-produced / AST-constrained&#xa;模型实施 source-bound rewrite plan&#xa;失败不回退发布 AST 产物" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;fontSize=13;" vertex="1" parent="p1-1"><mxGeometry x="1815" y="85" width="330" height="95" as="geometry"/></mxCell>
        <mxCell id="p1-ask" value="等待用户选择&#xa;接受：兼容性迁移&#xa;拒绝：GAP_REQUIRED&#xa;非交互环境不默认接受" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;fontSize=14;" vertex="1" parent="p1-1"><mxGeometry x="1815" y="205" width="330" height="105" as="geometry"/></mxCell>
        <mxCell id="p1-gapnext" value="进入第 2 页恢复流&#xa;只允许 missing / rejected audited fallback 生成 GapSpec" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;fontSize=14;" vertex="1" parent="p1-1"><mxGeometry x="1815" y="340" width="330" height="85" as="geometry"/></mxCell>
        <mxCell id="p1-auditnext" value="资格或源码审计&#xa;补 capability evidence 后重新扫描&#xa;禁止盲目生成同名替代算子" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;fontSize=14;" vertex="1" parent="p1-1"><mxGeometry x="1815" y="465" width="330" height="95" as="geometry"/></mxCell>
        <mxCell id="p1-stop" value="结构化 blocker/report&#xa;不调用迁移 GLM，不降级伪成功" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;fontSize=14;" vertex="1" parent="p1-1"><mxGeometry x="1815" y="600" width="330" height="80" as="geometry"/></mxCell>

        <mxCell id="p1-publish" value="统一发布门：exact AST + comments + receipt + content hash&#xa;write-once migrated.py + source/generator/artifact report&#xa;迁移阶段仍固定 execution=false，numerical=not_run，performance=false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;fontSize=13;" vertex="1" parent="p1-1"><mxGeometry x="1700" y="740" width="445" height="105" as="geometry"/></mxCell>
        <mxCell id="p1-hybrid" value="演进中的 hybrid router（target；当前尚未发布）&#xa;可证明的纯 namespace / 局部机械改写 → deterministic AST codemod&#xa;API 组合、控制流/跨函数语义、缺口实现 → configured model 候选&#xa;两路都汇入相同的 AST 差分、能力、回执、执行与数值门禁" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;dashPattern=8 8;fontSize=13;fontStyle=1;" vertex="1" parent="p1-1"><mxGeometry x="45" y="725" width="1550" height="120" as="geometry"/></mxCell>
        <mxCell id="p1-harness" value="迁移后两条独立显式事务（均不回写迁移报告）&#xa;verify-script：hash-bound 双进程 named-output 数值对拍；只证明数值&#xa;benchmark-script：marker 分段 AST + 独立单核 CPU/NPU + runtime/profile/call-count/sync/数值门&#xa;仅 performance_valid=true 发布 steady resident speedup；prefix / 最终 D2H / 组件和另列，非冷启动 E2E" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;" vertex="1" parent="p1-1"><mxGeometry x="1130" y="885" width="1015" height="110" as="geometry"/></mxCell>
        <mxCell id="p1-legacy" value="显式 legacy contract（不是默认入口）&#xa;migrate --mode contract；--mode auto 仅兼容&#xa;check-suite / wizard / bench-cpu / bench-npu 均要求 build_inputs + forward" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;dashPattern=8 8;fontSize=14;" vertex="1" parent="p1-1"><mxGeometry x="45" y="895" width="1015" height="90" as="geometry"/></mxCell>

        <mxCell id="p1-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;" edge="1" parent="p1-1" source="p1-ready" target="p1-source"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;" edge="1" parent="p1-1" source="p1-source" target="p1-scan"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;" edge="1" parent="p1-1" source="p1-scan" target="p1-cap"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e4" value="qualified" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82B366;" edge="1" parent="p1-1" source="p1-cap" target="p1-direct"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e5" value="audited fallback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D6B656;" edge="1" parent="p1-1" source="p1-cap" target="p1-consent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e6" value="missing" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;" edge="1" parent="p1-1" source="p1-cap" target="p1-gap"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e7" value="unknown / drift" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;" edge="1" parent="p1-1" source="p1-cap" target="p1-capaudit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e8" value="unmodeled" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#B85450;" edge="1" parent="p1-1" source="p1-cap" target="p1-blocked"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82B366;" edge="1" parent="p1-1" source="p1-direct" target="p1-glm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D6B656;" edge="1" parent="p1-1" source="p1-consent" target="p1-ask"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e11" value="接受" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D6B656;" edge="1" parent="p1-1" source="p1-ask" target="p1-glm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e12" value="拒绝" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;" edge="1" parent="p1-1" source="p1-ask" target="p1-gapnext"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;" edge="1" parent="p1-1" source="p1-gap" target="p1-gapnext"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;" edge="1" parent="p1-1" source="p1-capaudit" target="p1-auditnext"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#B85450;" edge="1" parent="p1-1" source="p1-blocked" target="p1-stop"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82B366;" edge="1" parent="p1-1" source="p1-glm" target="p1-publish"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e17" value="用户显式执行；不回写迁移阶段" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82B366;" edge="1" parent="p1-1" source="p1-publish" target="p1-harness"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e18" value="target complexity routing" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="p1-1" source="p1-direct" target="p1-hybrid"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="gap-recovery-flow" name="02-gap与资格化恢复流">
    <mxGraphModel dx="2200" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="p2-0"/>
        <mxCell id="p2-1" parent="p2-0"/>
        <mxCell id="p2-title" value="NumPilot 核心亮点：official-first 缺口恢复；当前自动到 adapter_candidate，完整本地能力闭环为 target" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="p2-1"><mxGeometry x="40" y="20" width="1350" height="45" as="geometry"/></mxCell>
        <mxCell id="p2-rule" value="implemented：实线且已有产品原语　 partial：实线但只到 candidate / validator&#xa;target：红/橙虚线，尚无产品闭环　 manual：灰虚线，可单独调用但不由 recovery 驱动" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D79B00;fontStyle=1;fontSize=13;" vertex="1" parent="p2-1"><mxGeometry x="1390" y="8" width="760" height="66" as="geometry"/></mxCell>

        <mxCell id="p2-missing" value="analyzed&#xa;GAP_REQUIRED：API missing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;fontSize=15;" vertex="1" parent="p2-1"><mxGeometry x="50" y="115" width="220" height="75" as="geometry"/></mxCell>
        <mxCell id="p2-rejected" value="analyzed&#xa;GAP_REQUIRED：用户拒绝 audited fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;fontSize=14;" vertex="1" parent="p2-1"><mxGeometry x="50" y="225" width="220" height="75" as="geometry"/></mxCell>
        <mxCell id="p2-unknown" value="analyzed&#xa;CAPABILITY_AUDIT_REQUIRED&#xa;callable + UNKNOWN / runtime drift" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;fontSize=13;" vertex="1" parent="p2-1"><mxGeometry x="50" y="370" width="220" height="82" as="geometry"/></mxCell>

        <mxCell id="p2-spec" value="gap_prepared&#xa;AST-derived Canonical GapSpec：source/callsite/signature/SoC/CANN 绑定&#xa;AST 只定义缺口合同，不生成 kernel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;fontSize=13;" vertex="1" parent="p2-1"><mxGeometry x="345" y="145" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="p2-lock" value="bootstrap 依赖已准备&#xa;official CANNBot commit + bundle hashes&#xa;若选择 CANNBot：CANN OSL 已显式接受" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;fontSize=14;" vertex="1" parent="p2-1"><mxGeometry x="345" y="285" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="p2-generation" value="无官方实现：configured model + 固定 CANNBot Skill&#xa;生成/repair/seal multi-file Ascend C provider artifact&#xa;结构/路径/hash 门已实现；Recovery remote candidate materializer 仍是 target" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;fontSize=11;" vertex="1" parent="p2-1"><mxGeometry x="725" y="145" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="p2-opsnn" value="resolved（implemented receipt prefix / partial action）&#xa;① installed CANN：exact SoC + header/symbol/hash&#xa;② 仅 ① clean NO_MATCH 才查 pinned ops-nn commit/tree/license&#xa;有候选：复用官方 kernel，不重新发明；仍需语义/构建/资格化&#xa;仅两层 clean NO_MATCH：才允许 CANNBot + model generation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;fontSize=11;" vertex="1" parent="p2-1"><mxGeometry x="725" y="285" width="280" height="140" as="geometry"/></mxCell>
        <mxCell id="p2-draft" value="candidate_ready（installed official_binary implemented）&#xa;fresh resolver + exact resolution_id + header/library rehash&#xa;五类 adapter refs + per-gap receipt；external toolkit terms accepted=false&#xa;仍是 qualified=0，activated=0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;fontSize=11;" vertex="1" parent="p2-1"><mxGeometry x="1085" y="145" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="p2-repair" value="model-driven repair + deterministic seal&#xa;诊断驱动单文件修复；封存只证明结构/证据完整&#xa;仍不等于 build / numerical / NPU execution 通过" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="p2-1"><mxGeometry x="1085" y="300" width="300" height="95" as="geometry"/></mxCell>
        <mxCell id="p2-adapter" value="adapter_candidate（reviewed MatMul implemented）&#xa;per-target projection + bounded edit windows&#xa;strict-SSE EXACT_EDIT → local exact rebuild&#xa;5 份成功 remote receipts&#xa;未 build / execute / activate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;fontStyle=1;" vertex="1" parent="p2-1"><mxGeometry x="1465" y="135" width="320" height="135" as="geometry"/></mxCell>

        <mxCell id="p2-integrate" value="integrated_candidate（target）&#xa;仅 full-local-recovery 可授权&#xa;producer 尚未实现；需隔离、可回滚" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#B85450;dashed=1;dashPattern=8 8;fontStyle=1;fontSize=12;" vertex="1" parent="p2-1"><mxGeometry x="1870" y="130" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="p2-qual" value="qualified（target）：六门&#xa;artifact / build / UT / numerical / public API / NPU&#xa;仅 full-local 可授权；producer 尚未接线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#B85450;dashed=1;dashPattern=8 8;fontStyle=1;fontSize=12;" vertex="1" parent="p2-1"><mxGeometry x="1870" y="285" width="280" height="125" as="geometry"/></mxCell>
        <mxCell id="p2-overlay" value="activated（target）&#xa;显式 capability overlay + runtime guard&#xa;仅 full-local 可授权；producer 尚未接线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#B85450;dashed=1;dashPattern=8 8;fontStyle=1;fontSize=13;" vertex="1" parent="p2-1"><mxGeometry x="1870" y="465" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="p2-rescan" value="rescanned（manual / target）&#xa;可手工用精确 runtime/overlay 重扫原文件&#xa;未由 recovery 自动触发；仍有 blocker 则停止" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;dashPattern=8 8;fontStyle=1;fontSize=12;" vertex="1" parent="p2-1"><mxGeometry x="1870" y="625" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="p2-final" value="final_migrated（manual / target）&#xa;可手工重新调用 GLM 生成 exact artifact&#xa;未由 recovery 驱动 AST/receipt/hash 门" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;dashPattern=8 8;fontStyle=1;fontSize=12;" vertex="1" parent="p2-1"><mxGeometry x="1870" y="785" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="p2-verified" value="verified（target）&#xa;最终迁移验证 receipt 通过&#xa;当前无自动推进器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#B85450;dashed=1;dashPattern=8 8;fontStyle=1;fontSize=13;" vertex="1" parent="p2-1"><mxGeometry x="1465" y="800" width="320" height="90" as="geometry"/></mxCell>

        <mxCell id="p2-sourceaudit" value="资格 / 源码审计&#xa;审计 existing callable 的真实实现和 runtime 身份&#xa;不进入 OperatorDraft" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;fontSize=14;" vertex="1" parent="p2-1"><mxGeometry x="345" y="465" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="p2-caprecord" value="version-bound capability record&#xa;证据不足仍保持 UNKNOWN&#xa;证据充分后回到 ordinary rescan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;" vertex="1" parent="p2-1"><mxGeometry x="725" y="465" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="p2-failure" value="任一步失败：保留 source/spec/artifact/diagnostic/hash/receipt 和当前状态&#xa;不静默回退、不写 qualified/activated、不覆盖历史产物；恢复必须从绑定检查点继续" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;fontSize=14;" vertex="1" parent="p2-1"><mxGeometry x="345" y="685" width="1040" height="95" as="geometry"/></mxCell>
        <mxCell id="p2-status" value="当前 Recovery 控制面（schema v2，逐 gap）&#xa;MatMul implemented 到 ADAPTER_CANDIDATE&#xa;candidate-generation 只允许 subprocess/network/model&#xa;仅 full-local 可授权 write/import/build/execute/activate&#xa;profile 冻结；权限 ≠ 已执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;fontSize=10;" vertex="1" parent="p2-1"><mxGeometry x="1085" y="465" width="300" height="145" as="geometry"/></mxCell>
        <mxCell id="p2-phase-contract" value="RecoveryPhase（代码唯一状态名）&#xa;created → analyzed → gap_prepared → resolved → candidate_ready → adapter_candidate → integrated_candidate → qualified → activated → rescanned → final_migrated → verified&#xa;candidate-generation 终止于 adapter_candidate；profile 不可升级&#xa;generated_unverified 是 artifact status；无 hash-bound receipt 不得推进" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;fontStyle=1;" vertex="1" parent="p2-1"><mxGeometry x="50" y="815" width="1335" height="110" as="geometry"/></mxCell>
        <mxCell id="p2-next" value="next target：official_source / remote_llm candidate、其他 adapter、isolated integration、六门 qualification、activation、rescan 与 final verification；需新 run 初始选择 full-local，不能升级 candidate-generation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;dashPattern=8 8;fontSize=14;" vertex="1" parent="p2-1"><mxGeometry x="50" y="955" width="2100" height="85" as="geometry"/></mxCell>

        <mxCell id="p2-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;" edge="1" parent="p2-1" source="p2-missing" target="p2-spec"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;" edge="1" parent="p2-1" source="p2-rejected" target="p2-spec"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;" edge="1" parent="p2-1" source="p2-unknown" target="p2-sourceaudit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82B366;" edge="1" parent="p2-1" source="p2-sourceaudit" target="p2-caprecord"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e6" value="两层 clean NO_MATCH 后才加载锁定 Skill" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D6B656;" edge="1" parent="p2-1" source="p2-lock" target="p2-generation"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e7" value="target：remote Artifact → Recovery operator_candidate receipt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#9673A6;" edge="1" parent="p2-1" source="p2-generation" target="p2-draft"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e8" value="remote draft：诊断后可 repair / seal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;" edge="1" parent="p2-1" source="p2-generation" target="p2-repair"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e9" value="implemented：target-window projection → strict-SSE exact edits → local rebuild" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82B366;" edge="1" parent="p2-1" source="p2-draft" target="p2-adapter"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e10" value="仅 full-local 可授权；producer 未接线" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#B85450;" edge="1" parent="p2-1" source="p2-adapter" target="p2-integrate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#B85450;" edge="1" parent="p2-1" source="p2-integrate" target="p2-qual"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#B85450;" edge="1" parent="p2-1" source="p2-qual" target="p2-overlay"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e13" value="target" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#B85450;" edge="1" parent="p2-1" source="p2-overlay" target="p2-rescan"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e14" value="manual / target" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="p2-1" source="p2-rescan" target="p2-final"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e15" value="manual：审计充分后重扫" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="p2-1" source="p2-caprecord" target="p2-rescan"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e16" value="implemented：resolve-gaps + receipt ingestion" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;" edge="1" parent="p2-1" source="p2-spec" target="p2-opsnn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e17" value="implemented：仅 installed exact route fresh materializer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82B366;" edge="1" parent="p2-1" source="p2-opsnn" target="p2-draft"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e18" value="仅两层 clean NO_MATCH → implemented model generation primitive" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;" edge="1" parent="p2-1" source="p2-opsnn" target="p2-generation"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e19" value="target" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#B85450;" edge="1" parent="p2-1" source="p2-final" target="p2-verified"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e20" value="manual primitive：sealed custom artifact → adapter" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#9673A6;" edge="1" parent="p2-1" source="p2-repair" target="p2-adapter"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="bootstrap-trust-boundary" name="03-安装与可信边界">
    <mxGraphModel dx="2200" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="p3-0"/>
        <mxCell id="p3-1" parent="p3-0"/>
        <mxCell id="p3-title" value="显式安装与可信边界：只克隆 NumPilot，一键或手工从锁定源码准备依赖" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="p3-1"><mxGeometry x="40" y="20" width="1500" height="45" as="geometry"/></mxCell>
        <mxCell id="p3-rule" value="默认不使用 wheelhouse；source 身份由实现精确锁定，历史 wheel+hash 只保留为可选高级路径" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D79B00;fontStyle=1;fontSize=14;" vertex="1" parent="p3-1"><mxGeometry x="1450" y="15" width="700" height="52" as="geometry"/></mxCell>

        <mxCell id="p3-user" value="用户显式动作&#xa;一键：install.sh --allow-network&#xa;手工：提供两个精确 checkout&#xa;CANNBot 需显式接受许可证" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontStyle=1;fontSize=15;" vertex="1" parent="p3-1"><mxGeometry x="55" y="125" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="p3-plan" value="bootstrap [--plan] [--json]&#xa;默认只读；检查环境并展示网络/文件/构建动作&#xa;不 clone/fetch/build/install" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;fontSize=14;" vertex="1" parent="p3-1"><mxGeometry x="355" y="115" width="320" height="110" as="geometry"/></mxCell>
        <mxCell id="p3-lock" value="实现内锁定&#xa;official AsNumpy source commit/tree&#xa;official CANNBot commit/bundle&#xa;--asnumpy-cache / --cannbot-cache 只改缓存位置" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;fontSize=14;" vertex="1" parent="p3-1"><mxGeometry x="745" y="105" width="340" height="130" as="geometry"/></mxCell>
        <mxCell id="p3-license" value="条件许可证门&#xa;只有 --with-cannbot 获取或复验内容时需&#xa;--accept-cannbot-license&#xa;单独 AsNumpy 不要求 CANN OSL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;fontSize=14;" vertex="1" parent="p3-1"><mxGeometry x="1160" y="105" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="p3-apply" value="bootstrap --apply [--receipt PATH]&#xa;默认：--build-asnumpy 从锁定源码构建&#xa;可选：本地 wheel+可信 hash&#xa;仅按显式请求执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;fontSize=14;" vertex="1" parent="p3-1"><mxGeometry x="1535" y="105" width="300" height="130" as="geometry"/></mxCell>

        <mxCell id="p3-wheel" value="可选历史/高级模式&#xa;--asnumpy-wheel PATH&#xa;--asnumpy-wheel-sha256 HEX&#xa;expected hash 来自可信发布物/用户输入，安装前校验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;fontSize=14;" vertex="1" parent="p3-1"><mxGeometry x="1535" y="300" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="p3-build" value="默认源码构建&#xa;install.sh 安装 .[bootstrap] 后调用 --build-asnumpy&#xa;只用锁定 commit/tree；可接用户手工 clean checkout&#xa;系统依赖缺失时不自动 sudo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;fontSize=14;" vertex="1" parent="p3-1"><mxGeometry x="1160" y="300" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="p3-cannbot" value="可选 CANNBot bundle&#xa;--with-cannbot + --accept-cannbot-license&#xa;official origin/commit、clean tree、bundle/逐文件 hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;fontSize=14;" vertex="1" parent="p3-1"><mxGeometry x="1910" y="300" width="260" height="120" as="geometry"/></mxCell>

        <mxCell id="p3-verify" value="Bootstrap atomic receipt + 运行时复验&#xa;source commit/tree + wrapper hashes + 动态 native 双份 hash + 模块/解释器路径&#xa;默认私有 XDG state；漂移即 CAPABILITY_AUDIT_REQUIRED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;fontSize=14;" vertex="1" parent="p3-1"><mxGeometry x="1475" y="500" width="500" height="115" as="geometry"/></mxCell>
        <mxCell id="p3-smoke" value="bootstrap --verify（本地复验）&#xa;AsNumpy：ap.ones((1000,1000), float32) + version/path/native hashes&#xa;可选 CANNBot：需 license acceptance，回答 Skill 清单；不联网、不调用模型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;fontSize=13;" vertex="1" parent="p3-1"><mxGeometry x="1110" y="680" width="400" height="110" as="geometry"/></mxCell>
        <mxCell id="p3-ready" value="Prepared runtime&#xa;capability 另行绑定 runtime/profile&#xa;doctor 只检查；migrate 只扫描/迁移" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;fontSize=15;" vertex="1" parent="p3-1"><mxGeometry x="1580" y="680" width="300" height="100" as="geometry"/></mxCell>

        <mxCell id="p3-forbidden" value="禁止的隐式行为" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;fontSize=16;" vertex="1" parent="p3-1"><mxGeometry x="55" y="310" width="960" height="470" as="geometry"/></mxCell>
        <mxCell id="p3-f1" value="pip 安装钩子或 import 触发网络 / git / build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=14;" vertex="1" parent="p3-forbidden"><mxGeometry x="30" y="65" width="400" height="65" as="geometry"/></mxCell>
        <mxCell id="p3-f2" value="doctor / migrate / complete-gaps 缓存缺失时偷偷下载" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=14;" vertex="1" parent="p3-forbidden"><mxGeometry x="500" y="65" width="400" height="65" as="geometry"/></mxCell>
        <mxCell id="p3-f3" value="未固定 branch/latest URL、未校验 wheel、文档编造下载地址" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=14;" vertex="1" parent="p3-forbidden"><mxGeometry x="30" y="165" width="400" height="65" as="geometry"/></mxCell>
        <mxCell id="p3-f4" value="未接受 CANN OSL 仍获取或使用 CANNBot / ops-nn 内容" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=14;" vertex="1" parent="p3-forbidden"><mxGeometry x="500" y="165" width="400" height="65" as="geometry"/></mxCell>
        <mxCell id="p3-f5" value="pip install/import 隐式编译，或没有 --allow-network / --build-asnumpy 就执行源码构建" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=14;" vertex="1" parent="p3-forbidden"><mxGeometry x="30" y="265" width="400" height="70" as="geometry"/></mxCell>
        <mxCell id="p3-f6" value="写系统 CANN/OPP、修改 shell 配置、覆盖现有 runtime 或把 shim 当 NPU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=14;" vertex="1" parent="p3-forbidden"><mxGeometry x="500" y="265" width="400" height="70" as="geometry"/></mxCell>
        <mxCell id="p3-note" value="失败关闭：环境、锁定 source 身份、wheel expected/actual hash 或条件许可证任一不匹配，都停止在 bootstrap；迁移命令不替用户修依赖" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D79B00;fontStyle=1;fontSize=15;" vertex="1" parent="p3-1"><mxGeometry x="55" y="890" width="2095" height="85" as="geometry"/></mxCell>

        <mxCell id="p3-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;" edge="1" parent="p3-1" source="p3-user" target="p3-plan"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;" edge="1" parent="p3-1" source="p3-plan" target="p3-lock"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e3" value="选择依赖" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D6B656;" edge="1" parent="p3-1" source="p3-lock" target="p3-license"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e4" value="完整显式参数" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;" edge="1" parent="p3-1" source="p3-license" target="p3-apply"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e5" value="可选 wheel 模式" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82B366;" edge="1" parent="p3-1" source="p3-apply" target="p3-wheel"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e6" value="仅显式 --build-asnumpy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D6B656;" edge="1" parent="p3-1" source="p3-apply" target="p3-build"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e7" value="可选 --with-cannbot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D6B656;" edge="1" parent="p3-1" source="p3-apply" target="p3-cannbot"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82B366;" edge="1" parent="p3-1" source="p3-wheel" target="p3-verify"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82B366;" edge="1" parent="p3-1" source="p3-build" target="p3-verify"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82B366;" edge="1" parent="p3-1" source="p3-cannbot" target="p3-verify"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;" edge="1" parent="p3-1" source="p3-verify" target="p3-smoke"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82B366;" edge="1" parent="p3-1" source="p3-smoke" target="p3-ready"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
