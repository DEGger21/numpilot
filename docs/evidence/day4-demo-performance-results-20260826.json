  "identified_issues": [
    {
      "id": "ASNUMPY_PUBLIC_WRAPPER_DEEP_COPY_AND_SYNC",
      "severity": "high",
      "finding": "public Python operators wrap a native result with ndarray(...); the bound base-class copy constructor allocates device memory, performs a full device-to-device copy, and synchronizes after the native executor has already synchronized",
      "observed_effect": "the public four-op Case06 chain is 21.51x to 59.15x slower than the private native diagnostic chain",
      "scope": "upstream AsNumpy runtime"
    },
    {
      "id": "ASNUMPY_FINE_GRAINED_SYNCHRONIZATION",
      "severity": "high",
      "finding": "the generic unary and binary executors call aclrtSynchronizeDevice after every operation, preventing asynchronous chaining",
      "scope": "upstream AsNumpy runtime"
    },
    {
      "id": "ASNUMPY_ALLOCATION_OVERHEAD",
      "severity": "medium",
      "finding": "two public NPU full allocations are 1.86x to 2.21x slower than the NumPy allocation reference at the frozen scales",
      "scope": "upstream AsNumpy runtime"
    },
    {
      "id": "ASNUMPY_CLIP_SCALAR_HANDLE_LEAK",
      "severity": "medium",
      "finding": "the scalar clip path creates amin and amax ACL scalar handles without destroying them",
      "scope": "upstream AsNumpy runtime"
    },
    {
      "id": "CASE02_DTYPE_CONTRACT_DRIFT",
      "severity": "high",
      "finding": "the migrated max_val output is float64 while NumPy returns float32; numerical verification fails and no speedup is publishable",
      "scope": "AsNumpy semantic compatibility and NumPilot gate"
    },
    {
      "id": "SMALL_SCRIPT_AND_COLD_FIXED_COST",
      "severity": "expected_but_material",
      "finding": "sub-millisecond exact script bodies are 2.68x to 5.28x slower on NPU, and fresh-process exact scripts are 19.58x to 21.85x slower, because dispatch, synchronization and CANN/Python initialization dominate useful work",
      "scope": "current execution model"
    }
  ],
