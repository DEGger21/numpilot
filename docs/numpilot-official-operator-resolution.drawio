        <mxCell id="ov-installed" value="① 已实现：installed ACLNN resolver&#xa;精确 Ascend910B3 + CANN 9.2.0-beta.2&#xa;header/libopapi symbols + hashes&#xa;命中仅为 candidate，语义仍未验证" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontStyle=1;" vertex="1" parent="ov-recovery"><mxGeometry x="310" y="80" width="270" height="125" as="geometry"/></mxCell>
        <mxCell id="ov-official" value="② 已实现：固定 v9.0.0 ops-nn resolver&#xa;名称命中只返回待审计 candidate&#xa;ops-math/provider registry 是后续扩展" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="ov-recovery"><mxGeometry x="625" y="55" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="ov-new-kernel" value="③ 仅 NO_MATCH 时&#xa;GLM + 固定 CANNBot Skill&#xa;生成/repair/seal 新 Ascend C kernel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="ov-recovery"><mxGeometry x="625" y="230" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="ov-private-opp" value="定向构建私有 OPP&#xa;仅选中算子；run-scoped + write-once&#xa;不覆盖系统 OPP，可回滚" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="ov-recovery"><mxGeometry x="980" y="75" width="285" height="105" as="geometry"/></mxCell>
        <mxCell id="ov-stop-review" value="REVIEW_REQUIRED / 来源或构建失败&#xa;保留诊断并停止；不得静默改走手写 kernel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;dashed=1;" vertex="1" parent="ov-recovery"><mxGeometry x="980" y="235" width="285" height="85" as="geometry"/></mxCell>
