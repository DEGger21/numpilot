    </mxGraphModel>
  </diagram>

  <diagram id="resolver" name="02-官方算子解析与门禁">
    <mxGraphModel dx="2500" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="rs-0"/>
        <mxCell id="rs-1" parent="rs-0"/>
        <mxCell id="rs-title" value="官方算子解析器：只读发现与收据门已实现；语义、构建、接入和发布继续失败关闭" style="text;html=1;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="rs-1"><mxGeometry x="40" y="20" width="1900" height="45" as="geometry"/></mxCell>
        <mxCell id="rs-rule" value="关键不变量：同名 ≠ 同语义；REVIEW_REQUIRED/构建失败 ≠ NO_MATCH；不得用静默回退隐藏官方候选问题" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=14;fontStyle=1;" vertex="1" parent="rs-1"><mxGeometry x="1550" y="75" width="900" height="62" as="geometry"/></mxCell>

        <mxCell id="rs-inputs" value="输入与运行上下文" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#EAF2F8;strokeColor=#6C8EBF;fontStyle=1;fontSize=17;" vertex="1" parent="rs-1"><mxGeometry x="40" y="85" width="1430" height="190" as="geometry"/></mxCell>
        <mxCell id="rs-gapspec" value="GapSpec&#xa;NumPy oracle + exact call contract&#xa;dtype/shape/attribute/mutation/reduction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontStyle=1;" vertex="1" parent="rs-inputs"><mxGeometry x="25" y="55" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="rs-env" value="环境指纹&#xa;CANN/toolkit/runtime version、SoC&#xa;headers/libopapi/module/native hashes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="rs-inputs"><mxGeometry x="370" y="55" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="rs-policy" value="解析策略&#xa;local-cache-first；provider allowlist&#xa;是否允许显式 fetch/build + 性能阈值" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="rs-inputs"><mxGeometry x="715" y="55" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="rs-runstate" value="已实现 recovery state 基础&#xa;source/target/runtime/policy + phase/refs&#xa;write-once hash-chain；不执行副作用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="rs-inputs"><mxGeometry x="1060" y="55" width="330" height="105" as="geometry"/></mxCell>

        <mxCell id="rs-installed-lane" value="第一层：已安装 CANN ACLNN（无需源码构建）" style="swimlane;html=1;rounded=1;startSize=36;fillColor=#EEF8EC;strokeColor=#82B366;fontStyle=1;fontSize=16;" vertex="1" parent="rs-1"><mxGeometry x="40" y="310" width="760" height="540" as="geometry"/></mxCell>
        <mxCell id="rs-inventory" value="已实现：本地 inventory&#xa;版本 + libopapi symbols + ACLNN headers + hashes&#xa;只读，不 load .so，不修改 CANN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontStyle=1;" vertex="1" parent="rs-installed-lane"><mxGeometry x="35" y="65" width="290" height="100" as="geometry"/></mxCell>
        <mxCell id="rs-installed-audit" value="已实现：有界 audited mapping&#xa;当前 exact SoC 仅 Ascend910B3&#xa;确认 header + 同一动态库两阶段 symbols&#xa;仅 candidate；语义审计仍待后续" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="rs-installed-lane"><mxGeometry x="390" y="50" width="320" height="130" as="geometry"/></mxCell>
        <mxCell id="rs-installed-decision" value="候选证据完整？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;fontStyle=1;" vertex="1" parent="rs-installed-lane"><mxGeometry x="270" y="230" width="200" height="115" as="geometry"/></mxCell>
        <mxCell id="rs-binary-artifact" value="目标：official_binary Artifact（未实现）&#xa;现阶段只有 resolution receipt&#xa;必须先生成 adapter 并完成语义/六门资格化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="rs-installed-lane"><mxGeometry x="35" y="395" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="rs-installed-no" value="NO_MATCH receipt&#xa;记录搜索空间和未匹配原因&#xa;转入官方源码 provider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="rs-installed-lane"><mxGeometry x="400" y="395" width="300" height="100" as="geometry"/></mxCell>

        <mxCell id="rs-source-lane" value="第二层：固定版本 ops-nn 已实现只读解析；多 provider 与构建仍为目标" style="swimlane;html=1;rounded=1;startSize=36;fillColor=#FFF8EE;strokeColor=#D79B00;fontStyle=1;fontSize=16;dashed=1;" vertex="1" parent="rs-1"><mxGeometry x="840" y="310" width="800" height="900" as="geometry"/></mxCell>
        <mxCell id="rs-provider-registry" value="目标：official_cann provider registry&#xa;当前只接入 ops-nn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="rs-source-lane"><mxGeometry x="30" y="60" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="rs-opsnn" value="已实现：ops-nn&#xa;v9.0.0 commit/tree 固定，只读 Git objects" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="rs-source-lane"><mxGeometry x="360" y="50" width="180" height="75" as="geometry"/></mxCell>
        <mxCell id="rs-opsmath" value="目标：ops-math&#xa;尚未接入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=12;dashed=1;" vertex="1" parent="rs-source-lane"><mxGeometry x="575" y="50" width="180" height="75" as="geometry"/></mxCell>
        <mxCell id="rs-source-supply" value="源码供应&#xa;优先使用用户提供的本地 cache&#xa;网络 fetch 只能是独立显式动作；固定 official origin + tag/commit/tree" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontStyle=1;" vertex="1" parent="rs-source-lane"><mxGeometry x="30" y="170" width="725" height="95" as="geometry"/></mxCell>
        <mxCell id="rs-gate-version" value="1 版本门&#xa;CANN release/ABI + exact SoC&#xa;family 不推断；当前 audited B4&#xa;拒绝 master/latest 漂移" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="rs-source-lane"><mxGeometry x="30" y="300" width="220" height="105" as="geometry"/></mxCell>
        <mxCell id="rs-gate-license" value="2 许可证门&#xa;显式接受并记录 receipt&#xa;保留 LICENSE/notices" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="rs-source-lane"><mxGeometry x="290" y="310" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="rs-gate-provenance" value="3 来源门&#xa;origin/commit/tree/files SHA-256&#xa;official_source 不冒充 remote_llm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="rs-source-lane"><mxGeometry x="550" y="310" width="205" height="90" as="geometry"/></mxCell>
        <mxCell id="rs-gate-semantics" value="4 语义门&#xa;签名/dtype/shape/broadcast/attributes&#xa;mutation/alias/reduction/multi-output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="rs-source-lane"><mxGeometry x="30" y="435" width="345" height="95" as="geometry"/></mxCell>
        <mxCell id="rs-gate-buildability" value="5 接入门&#xa;稳定级别、op_api symbol/header、依赖闭包&#xa;目标 SoC 可定向构建；实验算子需显式策略" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="rs-source-lane"><mxGeometry x="410" y="435" width="345" height="95" as="geometry"/></mxCell>
        <mxCell id="rs-source-decision" value="EXACT_MATCH&#xa;REVIEW_REQUIRED&#xa;NO_MATCH" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontStyle=1;" vertex="1" parent="rs-source-lane"><mxGeometry x="275" y="575" width="245" height="140" as="geometry"/></mxCell>
        <mxCell id="rs-target-build" value="目标（未实现）：定向构建&#xa;--ops=&lt;selected&gt; + exact SoC&#xa;私有、run-scoped、write-once OPP&#xa;封存 official_source Artifact + build/package manifests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="rs-source-lane"><mxGeometry x="30" y="755" width="345" height="110" as="geometry"/></mxCell>
        <mxCell id="rs-source-stop" value="REVIEW_REQUIRED / gate/build failure&#xa;保留候选、日志与诊断，停止等待审计&#xa;不把失败重分类为 NO_MATCH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;fontStyle=1;" vertex="1" parent="rs-source-lane"><mxGeometry x="410" y="755" width="345" height="110" as="geometry"/></mxCell>

        <mxCell id="rs-generated-lane" value="第三层：新 kernel（只有可证明的 NO_MATCH）" style="swimlane;html=1;rounded=1;startSize=36;fillColor=#F4EEFA;strokeColor=#9673A6;fontStyle=1;fontSize=16;dashed=1;" vertex="1" parent="rs-1"><mxGeometry x="1680" y="310" width="770" height="540" as="geometry"/></mxCell>
        <mxCell id="rs-cannbot" value="固定官方 CANNBot Skill bundle&#xa;版本/commit/逐文件 hashes 已验证&#xa;GLM 负责生成新 Ascend C kernel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontStyle=1;" vertex="1" parent="rs-generated-lane"><mxGeometry x="35" y="65" width="320" height="105" as="geometry"/></mxCell>
        <mxCell id="rs-draft" value="generated_unverified&#xa;draft + manifest + model receipts&#xa;diagnostic-driven repair → seal&#xa;封存仍不等于 qualified" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="rs-generated-lane"><mxGeometry x="410" y="65" width="310" height="105" as="geometry"/></mxCell>
        <mxCell id="rs-generated-build" value="生成算子定向构建&#xa;相同私有 OPP 事务和依赖闭包门禁&#xa;不得写系统 OPP / ~/.bashrc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontStyle=1;" vertex="1" parent="rs-generated-lane"><mxGeometry x="215" y="235" width="340" height="105" as="geometry"/></mxCell>
        <mxCell id="rs-generated-artifact" value="remote_llm Operator Artifact&#xa;kernel/source/model/response/build hashes&#xa;与官方来源类型严格区分" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="rs-generated-lane"><mxGeometry x="215" y="400" width="340" height="95" as="geometry"/></mxCell>

        <mxCell id="rs-integration" value="统一接入与发布（官方 binary / 官方 source / GLM kernel 三种来源汇合）" style="swimlane;html=1;rounded=1;startSize=36;fillColor=#F3F8FC;strokeColor=#6C8EBF;fontStyle=1;fontSize=16;dashed=1;" vertex="1" parent="rs-1"><mxGeometry x="40" y="1245" width="2410" height="205" as="geometry"/></mxCell>
        <mxCell id="rs-adapter" value="GLM AsNumpy custom-op integration Skill&#xa;输入 immutable Operator Artifact + exact OPP&#xa;schema v4：architecture/context hashes/overlay set/repair parent&#xa;manifest 优先，否则 legacy；避免冗余 D2D copy/sync" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;" vertex="1" parent="rs-integration"><mxGeometry x="35" y="45" width="430" height="135" as="geometry"/></mxCell>
        <mxCell id="rs-integrated" value="isolated integrated_candidate&#xa;可选加载 libcust_opapi；公共 ap.* API&#xa;不覆盖旧 runtime / audited fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="rs-integration"><mxGeometry x="520" y="60" width="350" height="105" as="geometry"/></mxCell>
        <mxCell id="rs-six" value="六门 correctness qualification&#xa;artifact_integrity / build_install / unit_tests&#xa;numerical_validation / public_asnumpy_api / npu_execution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#B85450;fontSize=11;fontStyle=1;" vertex="1" parent="rs-integration"><mxGeometry x="925" y="55" width="405" height="115" as="geometry"/></mxCell>
        <mxCell id="rs-perf" value="独立性能门与分析&#xa;同输入/环境、warmup、同步、重复分布、profile&#xa;回归先定位 copy/sync/host/cast/granularity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;" vertex="1" parent="rs-integration"><mxGeometry x="1385" y="55" width="385" height="115" as="geometry"/></mxCell>
        <mxCell id="rs-activate" value="显式 activation policy&#xa;六门通过 + 性能策略通过&#xa;发布 overlay → rescan → final GLM migration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontStyle=1;" vertex="1" parent="rs-integration"><mxGeometry x="1825" y="55" width="520" height="115" as="geometry"/></mxCell>

        <mxCell id="rs-prohibitions" value="禁止：默认 bootstrap 拉取 ops-nn/ops-math｜浮动 master/latest｜隐式接受许可证｜系统 OPP 写入｜修改 ~/.bashrc｜候选失败后静默手写｜把 official_source 标成 remote_llm｜名称匹配后跳过六门" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=14;fontStyle=1;" vertex="1" parent="rs-1"><mxGeometry x="1680" y="900" width="770" height="245" as="geometry"/></mxCell>

        <mxCell id="rs-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82B366;" edge="1" parent="rs-installed-lane" source="rs-inventory" target="rs-installed-audit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rs-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D6B656;" edge="1" parent="rs-installed-lane" source="rs-installed-audit" target="rs-installed-decision"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rs-e3" value="EXACT_MATCH" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82B366;fontSize=11;" edge="1" parent="rs-installed-lane" source="rs-installed-decision" target="rs-binary-artifact"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rs-e4" value="NO_MATCH" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;fontSize=11;" edge="1" parent="rs-installed-lane" source="rs-installed-decision" target="rs-installed-no"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rs-e4b" value="进入源码解析" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#D79B00;fontSize=11;" edge="1" parent="rs-1" source="rs-installed-no" target="rs-provider-registry"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rs-context1" value="精确契约" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;fontSize=11;" edge="1" parent="rs-1" source="rs-gapspec" target="rs-inventory"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rs-context2" value="环境身份" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#82B366;fontSize=11;" edge="1" parent="rs-1" source="rs-env" target="rs-inventory"><mxGeometry relative="1" as="geometry"/></mxCell>
