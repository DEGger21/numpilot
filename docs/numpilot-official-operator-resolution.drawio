        <mxCell id="rs-e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;" edge="1" parent="rs-source-lane" source="rs-source-supply" target="rs-gate-version"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rs-e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;" edge="1" parent="rs-source-lane" source="rs-gate-version" target="rs-gate-license"><mxGeometry relative="1" as="geometry"/></mxCell>
