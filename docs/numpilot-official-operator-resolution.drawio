        <mxCell id="ov-direct" value="DIRECT&#xa;strict / qualified scoped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;" vertex="1" parent="ov-ordinary"><mxGeometry x="1210" y="45" width="270" height="62" as="geometry"/></mxCell>
        <mxCell id="ov-fallback" value="FALLBACK_CONSENT&#xa;audited CPU/host-assisted；等待用户选择" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="ov-ordinary"><mxGeometry x="1210" y="120" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="ov-gap" value="GAP_REQUIRED&#xa;missing 或用户拒绝 fallback&#xa;进入 C 区恢复流" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontStyle=1;" vertex="1" parent="ov-ordinary"><mxGeometry x="1210" y="205" width="270" height="72" as="geometry"/></mxCell>
        <mxCell id="ov-audit" value="CAPABILITY_AUDIT_REQUIRED / BLOCKED&#xa;补证据或结构化停止；不盲目生成同名算子" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="ov-ordinary"><mxGeometry x="1530" y="205" width="360" height="72" as="geometry"/></mxCell>
