  <diagram id="runtime-evidence" name="03-运行时、资格化与证据">
    <mxGraphModel dx="2500" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="rt-0"/>
        <mxCell id="rt-1" parent="rt-0"/>
        <mxCell id="rt-title" value="运行时与证据闭环：正确性、性能、激活是相互独立且哈希绑定的状态" style="text;html=1;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="rt-1"><mxGeometry x="40" y="20" width="1780" height="45" as="geometry"/></mxCell>
        <mxCell id="rt-note" value="只有 qualification 六门全部 passed 才可称 qualified；性能结论来自独立 benchmark；activation 必须是随后发生的显式动作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D79B00;fontSize=14;fontStyle=1;" vertex="1" parent="rt-1"><mxGeometry x="1470" y="15" width="980" height="62" as="geometry"/></mxCell>

        <mxCell id="rt-runtime" value="实际 NPU 数据路径" style="swimlane;html=1;rounded=1;startSize=36;fillColor=#EEF8EC;strokeColor=#82B366;fontStyle=1;fontSize=17;" vertex="1" parent="rt-1"><mxGeometry x="40" y="105" width="2410" height="260" as="geometry"/></mxCell>
        <mxCell id="rt-migrated" value="最终 migrated.py&#xa;import asnumpy as ap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="rt-runtime"><mxGeometry x="30" y="85" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="rt-public" value="公共 AsNumpy API&#xa;精确签名、dtype/shape 契约" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="rt-runtime"><mxGeometry x="305" y="80" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="rt-adapter" value="GLM adapter overlay&#xa;已有 NPU ndarray 直通&#xa;NumPy 输入显式 from_numpy；避免冗余 copy/sync" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontStyle=1;" vertex="1" parent="rt-runtime"><mxGeometry x="610" y="65" width="315" height="120" as="geometry"/></mxCell>
        <mxCell id="rt-loader" value="可选 custom-op loader&#xa;只有 overlay 要求时加载私有 libcust_opapi&#xa;缺失/身份漂移失败关闭" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="rt-runtime"><mxGeometry x="970" y="65" width="315" height="120" as="geometry"/></mxCell>
        <mxCell id="rt-installed-api" value="已安装 CANN libopapi&#xa;official_binary route" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="rt-runtime"><mxGeometry x="1340" y="45" width="275" height="75" as="geometry"/></mxCell>
        <mxCell id="rt-private-api" value="私有 OPP / libcust_opapi&#xa;official_source 或 remote_llm route&#xa;run-scoped，绝不覆盖系统 OPP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="rt-runtime"><mxGeometry x="1340" y="140" width="275" height="85" as="geometry"/></mxCell>
        <mxCell id="rt-guard" value="runtime guard&#xa;overlay scope + module/native/package hashes&#xa;CANN/SoC/OPP identity 必须与资格证据一致" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;fontStyle=1;" vertex="1" parent="rt-runtime"><mxGeometry x="1670" y="65" width="345" height="120" as="geometry"/></mxCell>
        <mxCell id="rt-npu" value="Ascend NPU&#xa;strict device execution&#xa;禁止未声明 CPU/host fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;" vertex="1" parent="rt-runtime"><mxGeometry x="2070" y="75" width="285" height="100" as="geometry"/></mxCell>

        <mxCell id="rt-qualification" value="六门 correctness qualification（同一 sealed artifact + 同一环境指纹）" style="swimlane;html=1;rounded=1;startSize=36;fillColor=#FFF8EE;strokeColor=#B85450;fontStyle=1;fontSize=17;" vertex="1" parent="rt-1"><mxGeometry x="40" y="400" width="1510" height="350" as="geometry"/></mxCell>
        <mxCell id="rt-q1" value="1 artifact_integrity&#xa;manifest/schema/signature/hashes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=12;fontStyle=1;" vertex="1" parent="rt-qualification"><mxGeometry x="35" y="70" width="420" height="80" as="geometry"/></mxCell>
        <mxCell id="rt-q2" value="2 build_install&#xa;隔离构建、私有安装、import/load" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=12;fontStyle=1;" vertex="1" parent="rt-qualification"><mxGeometry x="525" y="70" width="420" height="80" as="geometry"/></mxCell>
        <mxCell id="rt-q3" value="3 unit_tests&#xa;adapter/operator 边界、错误契约" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=12;fontStyle=1;" vertex="1" parent="rt-qualification"><mxGeometry x="1015" y="70" width="420" height="80" as="geometry"/></mxCell>
        <mxCell id="rt-q4" value="4 numerical_validation&#xa;NumPy oracle、dtype/shape/tolerance/edge cases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=12;fontStyle=1;" vertex="1" parent="rt-qualification"><mxGeometry x="35" y="195" width="420" height="80" as="geometry"/></mxCell>
        <mxCell id="rt-q5" value="5 public_asnumpy_api&#xa;只测 _core 不算通过；必须覆盖 ap.*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=12;fontStyle=1;" vertex="1" parent="rt-qualification"><mxGeometry x="525" y="195" width="420" height="80" as="geometry"/></mxCell>
        <mxCell id="rt-q6" value="6 npu_execution&#xa;真机、精确 SoC/runtime、无意外 host escape" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=12;fontStyle=1;" vertex="1" parent="rt-qualification"><mxGeometry x="1015" y="195" width="420" height="80" as="geometry"/></mxCell>

        <mxCell id="rt-performance" value="独立性能证据与回归分析" style="swimlane;html=1;rounded=1;startSize=36;fillColor=#EAF2F8;strokeColor=#6C8EBF;fontStyle=1;fontSize=17;" vertex="1" parent="rt-1"><mxGeometry x="1590" y="400" width="860" height="350" as="geometry"/></mxCell>
