        <mxCell id="ov-title" value="NumPilot + 华为官方算子解析：当前架构与建议闭环" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="ov-1"><mxGeometry x="40" y="20" width="1320" height="45" as="geometry"/></mxCell>
        <mxCell id="ov-legend" value="蓝/绿实线：当前已有能力　　橙色/虚线：目标闭环或尚未完成　　紫色：配置的 GLM 模型动作　　红色：失败关闭" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=14;fontStyle=1;" vertex="1" parent="ov-1"><mxGeometry x="1430" y="15" width="1020" height="55" as="geometry"/></mxCell>

        <mxCell id="ov-foundation" value="A　安装、配置与模型契约（现有）" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#EAF2F8;strokeColor=#6C8EBF;fontStyle=1;fontSize=17;" vertex="1" parent="ov-1"><mxGeometry x="40" y="90" width="2410" height="180" as="geometry"/></mxCell>
        <mxCell id="ov-user" value="用户显式准备&#xa;bootstrap plan/apply/verify&#xa;网络与构建均需显式参数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=13;" vertex="1" parent="ov-foundation"><mxGeometry x="25" y="55" width="260" height="95" as="geometry"/></mxCell>
        <mxCell id="ov-lock" value="锁定供应链&#xa;AsNumpy source commit/tree&#xa;CANNBot commit + Skill hashes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="ov-foundation"><mxGeometry x="330" y="55" width="285" height="95" as="geometry"/></mxCell>
        <mxCell id="ov-config" value="LLM 配置&#xa;.numpilot-config/llm.json&#xa;endpoint/model/auth + receipts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="ov-foundation"><mxGeometry x="660" y="55" width="275" height="95" as="geometry"/></mxCell>
        <mxCell id="ov-model-contract" value="模型所有权契约&#xa;GLM 生成迁移、kernel/adapter candidate&#xa;NumPilot 验证、封存、门禁；不伪造模型产物" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;" vertex="1" parent="ov-foundation"><mxGeometry x="980" y="45" width="360" height="110" as="geometry"/></mxCell>
        <mxCell id="ov-runtime-id" value="运行时身份&#xa;Python/module/native hashes&#xa;CANN version + exact SoC&#xa;当前 audited：Ascend910B3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="ov-foundation"><mxGeometry x="1385" y="45" width="305" height="110" as="geometry"/></mxCell>
        <mxCell id="ov-safety" value="全局约束&#xa;import/migrate/doctor 不隐式联网&#xa;不写系统 CANN/OPP，不修改 shell 配置&#xa;许可证、来源和版本不满足即停止" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;fontStyle=1;" vertex="1" parent="ov-foundation"><mxGeometry x="1735" y="45" width="630" height="110" as="geometry"/></mxCell>

        <mxCell id="ov-ordinary" value="B　ordinary migrate：默认用户路径（现有）" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#F3F8FC;strokeColor=#6C8EBF;fontStyle=1;fontSize=17;" vertex="1" parent="ov-1"><mxGeometry x="40" y="300" width="2410" height="330" as="geometry"/></mxCell>
        <mxCell id="ov-source" value="普通 NumPy 源文件&#xa;无需 build_inputs / forward" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=14;fontStyle=1;" vertex="1" parent="ov-ordinary"><mxGeometry x="25" y="95" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="ov-ast" value="整文件静态 AST 扫描&#xa;不 import、不执行源码&#xa;解析 API、method、签名与 callsite" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="ov-ordinary"><mxGeometry x="300" y="85" width="280" height="100" as="geometry"/></mxCell>
