        <mxCell id="rt-profile" value="出现回归先分析&#xa;冗余 H2D/D2H/D2D copy、强制 sync、host fallback&#xa;dtype cast、动态编译/warmup、过小 kernel、Python wrapper 税" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontStyle=1;" vertex="1" parent="rt-performance"><mxGeometry x="35" y="205" width="780" height="85" as="geometry"/></mxCell>

        <mxCell id="rt-state" value="已实现状态链基础；图示发布顺序仍需 receipt adapter 驱动" style="swimlane;html=1;rounded=1;startSize=36;fillColor=#F4EEFA;strokeColor=#9673A6;fontStyle=1;fontSize=17;" vertex="1" parent="rt-1"><mxGeometry x="40" y="790" width="2410" height="205" as="geometry"/></mxCell>
