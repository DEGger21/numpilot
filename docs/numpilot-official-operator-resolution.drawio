        <mxCell id="ov-migration-artifact" value="write-once 迁移 Artifact&#xa;migrated.py + report + receipts&#xa;普通迁移不虚报 numerical/performance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="ov-ordinary"><mxGeometry x="1940" y="55" width="400" height="100" as="geometry"/></mxCell>

        <mxCell id="ov-recovery" value="C　GAP_REQUIRED 恢复闭环（resolver + hash-chain 状态基础已实现；MatMul 受限纵切已真机验证；步骤自动驱动仍为目标）" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#FFF8EE;strokeColor=#D79B00;fontStyle=1;fontSize=17;dashed=1;dashPattern=8 6;" vertex="1" parent="ov-1"><mxGeometry x="40" y="665" width="2410" height="455" as="geometry"/></mxCell>
