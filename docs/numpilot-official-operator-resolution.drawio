        <mxCell id="ov-e29" value="仍有 gap" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#D79B00;fontSize=11;" edge="1" parent="ov-recovery" source="ov-rescan" target="ov-gapspec"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1785" y="405"/><mxPoint x="145" y="405"/></Array></mxGeometry></mxCell>
