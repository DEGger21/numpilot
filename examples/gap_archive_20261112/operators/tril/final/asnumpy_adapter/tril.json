          "layout": "C",
          "generator": "np.full((2048, 2048), -1.0, dtype=np.float32)"
        },
        "expected": "np.tril(a, k=0)",
        "assertions": [
          "upper triangle is bitwise +0.0f",
          "lower triangle and diagonal are -1.0f",
          "bitwise_equal(actual, expected)"
        ]
      },
      {
        "id": "special_values_and_signed_zero",
        "call": "asnumpy.tril(a)",
        "input": {
          "dtype": "float32",
          "shape": [
            2048,
            2048
          ],
          "layout": "C",
          "generator": "a = np.linspace(-10.0, 10.0, 2048 * 2048, dtype=np.float32).reshape(2048, 2048); a[0, 0] = np.float32(-0.0); a[0, 1] = np.float32(np.nan); a[1, 0] = np.float32(np.inf); a[1, 2] = np.float32(-np.inf); a[2, 2] = np.float32(np.nan)"
        },
        "expected": "np.tril(a, k=0)",
        "assertions": [
          "masked NaN and infinities become bitwise +0.0f",
          "retained NaN, infinities, and -0.0f are bit-preserved",
          "bitwise_equal(actual, expected)"
        ]
      },
      {
        "id": "repeated_call_lifecycle",
        "call": "asnumpy.tril(a) three times with fresh admitted inputs",
        "input": {
          "dtype": "float32",
          "shape": [
            2048,
            2048
          ],
          "layout": "C",
          "generator": "np.full((2048, 2048), fill_value, dtype=np.float32) for fill_value in (-3.0, 0.0, 7.0)"
        },
        "expected": "np.tril(a, k=0) independently for each call",
        "assertions": [
          "no state leaks between calls",
          "all three outputs match their corresponding oracle results",
          "input arrays remain unchanged"
        ]
