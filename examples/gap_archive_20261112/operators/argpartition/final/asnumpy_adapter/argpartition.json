  "semantic_contract": {
    "definition": "Return an int64 index tensor of the same shape as a such that selecting values from a with those indices along normalized axis yields a valid NumPy argpartition result at normalized kth.",
    "axis_normalization": "If axis < 0, add a.ndim. A normalized axis must satisfy 0 <= axis < a.ndim. The admitted profile normalizes axis to 1.",
    "kth_normalization": "If kth < 0, add a.shape[normalized_axis]. A normalized kth must satisfy 0 <= kth < a.shape[normalized_axis]. The admitted profile normalizes kth to 3.",
    "normalized_axis": 1,
    "normalized_kth": 3,
    "axis_length": 16,
    "partition_order": "NumPy total order: -inf < finite values < +inf < NaN. Negative zero and positive zero compare equal for partition ordering.",
    "partition_predicate": "For every index i < normalized_kth and every index j > normalized_kth along the normalized axis, order(value[i]) <= order(value[normalized_kth]) and order(value[normalized_kth]) <= order(value[j]).",
    "index_permutation": "Each slice along the normalized axis must be a permutation of the integer range [0, axis_length).",
    "value_preservation": "Selected values must retain the exact original float32 bit patterns, including signbit and NaN payload.",
    "ties": "Exact index sequence equality with numpy.argpartition is not required because argpartition is non-unique. The partition predicate, index permutation, and value-bit preservation are required.",
    "return_structure": "single_tensor",
    "bool_tensor_outputs": []
  },
