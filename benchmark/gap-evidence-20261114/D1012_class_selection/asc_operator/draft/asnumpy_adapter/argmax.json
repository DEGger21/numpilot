  "numerical_contract": {
    "output_comparison": "exact_integer_equality",
    "rtol": 0.0,
    "atol": 0.0,
    "dtype_exact": true,
    "shape_exact": true,
    "tie_break": "first_occurrence",
    "nan": "first NaN is treated as the maximum",
    "pos_inf": "positive infinity is the maximum",
    "neg_inf": "negative infinity is the minimum; all negative infinity returns index 0",
    "signed_zero": "positive zero and negative zero compare equal; first occurrence wins",
    "bool_results": "any boolean comparison result must be bool and exact",
    "no_downcast_to_float32": true,
    "special_value_decode": "test_adapter.special_tokens"
  },
  "runtime_guards": [
    "public tests call asnumpy.argmax and not only asnumpy._C.argmax",
    "input dtype must be exactly float32; no implicit cast is permitted",
    "input must be C-contiguous",
    "input rank must be in [1, 8]",
    "input element count must be in [1, 2147483647]",
    "axis must be an int64 keyword and must be within [-rank, rank-1] after normalization",
    "axis=None, missing axis, and second positional axis are rejected explicitly",
    "output must be int64 with the exact shape obtained by removing the normalized axis",
    "aclnnArgmaxGetWorkspaceSize must return ACL_SUCCESS",
    "workspace must be allocated only when workspace size is greater than zero and must be freed",
    "aclnnArgmax must return ACL_SUCCESS",
    "the stream must be synchronized before reading the result",
    "no NumPy or host CPU fallback may produce the actual result",
    "repeated execution with the same input must return identical indices",
    "L0 op_api sources that use l0op symbols require CANN opapi to be linked into cust_opapi"
  ],
  "build_contract": {
    "isolated_build": true,
    "system_cann_untouched": true,
    "shared_asnumpy_checkout_untouched": true,
    "link_opapi_into_cust_opapi_if_l0op_symbols_used": true,
