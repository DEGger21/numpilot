+def _can_use_native_matmul(x1: ArrayLike, x2: ArrayLike) -> bool:
+    """Return whether the audited 2-D float32 ACLNN path is applicable."""
+
+    return (
+        isinstance(x1, ndarray)
+        and isinstance(x2, ndarray)
+        and x1.ndim == 2
+        and x2.ndim == 2
+        and x1.dtype == np.dtype(np.float32)
+        and x2.dtype == np.dtype(np.float32)
+        and x1.shape[1] == x2.shape[0]
+    )
+
+
